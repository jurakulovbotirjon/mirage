# Python bytecode and package/build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.wheels/

# Virtual environments and local tooling
.venv/
.venv-modelscope/
venv/
.env
.env.*
!.env.example
.python-version
